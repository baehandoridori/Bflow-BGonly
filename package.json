{
  "name": "bflow",
  "version": "1.25.6",
  "description": "B flow - Studio JBBJ 워크플로우 대시보드",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:auto-update": "node --test ./tests/autoUpdateHelperSwap.test.ts ./tests/autoUpdateManifest.test.ts ./tests/autoUpdateFailurePolicy.test.ts ./tests/autoUpdateInstallerFlow.test.ts",
    "build": "npm run typecheck && npm run test:auto-update && vite build && electron-builder && node scripts/generate-manifest.js",
    "build:vite": "npm run typecheck && npm run test:auto-update && vite build && node scripts/generate-manifest.js --allow-missing-installer",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "lint": "eslint src --ext ts,tsx"
  },
  "author": "Studio JBBJ",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/gowun-dodum": "^5.2.8",
    "@fontsource/ibm-plex-sans-kr": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/nanum-gothic": "^5.2.7",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-serif-kr": "^5.2.9",
    "@liveblocks/client": "^3.14.1",
    "@liveblocks/react": "^3.14.1",
    "@supabase/supabase-js": "^2.99.1",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "bflow": "file:.claude/worktrees/hardcore-bardeen-8d3837",
    "clsx": "^2.1.0",
    "framer-motion": "^10.18.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.303.0",
    "opentype.js": "^1.3.5",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.4.4",
    "sonner": "^2.0.7",
    "tiptap-markdown": "^0.8.10",
    "wawoff2": "^2.0.1",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.studiojbbj.bflow",
    "productName": "BFLOW",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/splash/**",
      "node_modules/**/*",
      "!node_modules/@fontsource/**",
      "!node_modules/pretendard/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "B flow",
      "menuCategory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "BFLOW-Setup.${ext}"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
