    "test:character": "node --test ./tests/characterBoardStoreHelpers.test.ts ./tests/characterBoardAssetWorkflow.test.ts ./tests/characterCostumeName.test.ts ./tests/characterName.test.ts ./tests/characterCostumeReorder.test.ts ./tests/characterFeedbackBatch.test.ts ./tests/characterTier2.test.ts ./tests/dueDateBadge.test.ts ./tests/riggingAnnounce.test.ts ./tests/characterFeedback3.test.ts ./tests/clipboardFilePaste.test.ts ./tests/dropEdgeFor.test.ts ./tests/characterHeightKey.test.ts ./tests/characterFeedback4.test.ts ./tests/characterBoardTabs.test.ts ./tests/characterStatusFilter.test.ts ./tests/costumePresenceWiring.test.ts",
    "test:gantt": "node --test ./tests/ganttDomain.test.ts ./tests/ganttGeometry.test.ts ./tests/ganttCanvas.test.ts ./tests/ganttCreationUi.test.ts ./tests/ganttShareTooltip.test.ts ./tests/ganttPersistence.test.ts ./tests/ganttPreview.test.ts ./tests/ganttMockWiring.test.ts ./tests/ganttQuickEdit.test.ts",
    "test:ui": "node --test ./tests/sidebarNavVisibility.test.ts ./tests/compositingCarouselLayer.test.ts ./tests/compositorAssign.test.ts ./tests/calendarIntegrationStatus.test.ts ./tests/appHeaderLayering.test.ts",
    "test:calendar": "node --test ./tests/calendarDateUtils.test.ts ./tests/calendarPermissions.test.ts ./tests/calendarStoreStorage.test.ts ./tests/calendarStorePartialFailure.test.ts ./tests/calendarIpcValidation.test.ts ./tests/calendarRealtimeFanout.test.ts ./tests/calendarPrivacyRouting.test.ts ./tests/calendarLegacyMigrationDelete.test.ts ./tests/calendarTagsPersistence.test.ts ./tests/calendarMembersPersistence.test.ts ./tests/calendarGoogleCacheReadiness.test.ts ./tests/calendarQuickEditCapabilities.test.ts ./tests/calendarMutationFailureUi.test.ts ./tests/userIpcAuthorization.test.ts ./tests/calendarEventFilter.test.ts ./tests/calendarSharedUi.test.ts ./tests/calendarScheduleNavigationStore.test.ts ./tests/calendarUiCacheConsumers.test.ts ./tests/calendarNotifications.test.ts ./tests/timeGridLayout.test.ts ./tests/timeGridDnD.test.ts ./tests/timeGridDnD.dom.test.ts ./tests/weekTimeGridView.test.ts ./tests/calendarEventDiff.test.ts ./tests/icsSubscriptions.test.ts ./tests/ipcErrorMessage.test.ts ./tests/entityAwareInputDisabled.test.ts ./tests/calendarWeekdays.test.ts",
    "build": "npm run typecheck && npm run test:playground && npm run test:auto-update && npm run test:entity && npm run test:notifications && npm run test:presence && npm run test:character && npm run test:calendar && npm run test:ui && npm run test:gantt && vite build && electron-builder && node scripts/generate-manifest.js",
    "build:vite": "npm run typecheck && npm run test:playground && npm run test:auto-update && npm run test:entity && npm run test:notifications && npm run test:presence && npm run test:character && npm run test:calendar && npm run test:ui && npm run test:gantt && vite build && node scripts/generate-manifest.js --allow-missing-installer",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "lint": "eslint src --ext ts,tsx"
  },
  "author": "Studio JBBJ",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@fontsource/gowun-dodum": "^5.2.8",
    "@fontsource/ibm-plex-sans-kr": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/nanum-gothic": "^5.2.7",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-serif-kr": "^5.2.9",
    "@liveblocks/client": "^3.14.1",
    "@liveblocks/react": "^3.14.1",
    "@supabase/supabase-js": "^2.99.1",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "bflow": "file:.claude/worktrees/hardcore-bardeen-8d3837",
    "clsx": "^2.1.0",
    "framer-motion": "^10.18.0",
    "googleapis": "^171.4.0",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^0.303.0",
    "node-ical": "^0.27.1",
    "opentype.js": "^1.3.5",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.4.4",
    "sonner": "^2.0.7",
    "tiptap-markdown": "^0.8.10",
    "wawoff2": "^2.0.1",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.studiojbbj.bflow",
    "productName": "BFLOW",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/splash/**",
      "node_modules/**/*",
      "!node_modules/@fontsource/**",
      "!node_modules/pretendard/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "B flow",
      "menuCategory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "BFLOW-Setup.${ext}"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
